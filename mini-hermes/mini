#!/usr/bin/env bash
# mini-hermes 启动器。
#
# 做三件事，都是为了"别人 clone 下来也能跑"：
#   1. cd 到项目根目录 —— Python 把脚本目录加进 sys.path，自己的模块才 import 得到
#   2. 挑一个解释器 —— 不硬编码路径，别人机器上没有 /usr/local/bin/python3
#   3. 检查版本下限 —— 报错清楚，而不是抛一堆看不懂的语法错误
set -euo pipefail

# ---- ① 先记下"用户敲命令时所在的目录"，再 cd 到项目根 ----
# ★ 顺序**不能颠倒**：cd 之后 $PWD 就变成项目根了，用户的目录就永久丢了。
#   Python 那边靠 MINI_LAUNCH_CWD 才知道"用户的项目在哪"——
#   否则 AGENTS.md 的发现和工作区快照都会指向 mini-hermes 自己的目录。
#   （对应 Hermes 的 launch artifact 问题，见 prompt_builder.resolve_context_cwd）
export MINI_LAUNCH_CWD="${MINI_LAUNCH_CWD:-$PWD}"

# ---- ② 解析符号链接，再 cd 到项目根目录 ----
# Python 靠"脚本目录在 sys.path 上"才 import 得到自己的模块。
#
# ★ 两个坑都要处理：
#   a) 用户可能是 `bash mini`，$0 是相对路径 —— 先 cd 再算 dirname 会算到错的地方。
#      所以这里是"先算出绝对路径、再 cd"。
#   b) 用户可能把 mini **符号链接**到 PATH 上（`ln -s .../mini /usr/local/bin/mini`）
#      —— 这是最自然的省事做法。这时 $0 是**链接名**，dirname 拿到的是链接所在的目录
#      （例如 /usr/local/bin），cd 过去以后 `python3 -m hermes_cli.main` 找不到模块，
#      报出来的却是 "No module named 'hermes_cli'" —— 看起来像装了坏包。
#   macOS 自带的 readlink **不支持 -f**，所以自己循环解析。
_src="$0"
while [ -L "$_src" ]; do
    _dir="$(cd "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    case "$_src" in
        /*) ;;                          # 绝对链接，直接用
        *) _src="$_dir/$_src" ;;        # 相对链接：相对"链接所在目录"，不是 cwd
    esac
done
MINI_DIR="$(cd "$(dirname "$_src")" && pwd)"
cd "$MINI_DIR"

# ---- 挑解释器：显式指定 > 项目 venv > PATH 上的 python3 ----
if [ -n "${MINI_PYTHON:-}" ]; then
    PY="$MINI_PYTHON"
elif [ -x ".venv/bin/python3" ]; then
    PY=".venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PY="$(command -v python3)"
else
    echo "找不到 python3。装一个（macOS: brew install python@3.12），或设 MINI_PYTHON 指过去。" >&2
    exit 1
fi

# ---- 版本下限（实测 3.9 可以跑，见 README）----
if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)'; then
    echo "mini-hermes 需要 Python 3.9+，当前是 $("$PY" -V 2>&1)。" >&2
    exit 1
fi

# ---- 防御性：历史上这台机器的 PYTHONPATH 被污染过一次 ----
unset PYTHONPATH

exec "$PY" -m hermes_cli.main "$@"
